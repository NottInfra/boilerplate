# Shared across all environments — always loaded by cmd/lib/Env.ps1
# Service URLs live in settings.cfg → ENDPOINTS (CLUSTER|PUBLIC via NETWORK).

# ── Sigstore / gitsign ────────────────────────────────────────────────────
OIDC_CLIENT_ID=

# ── Defect Dojo ───────────────────────────────────────────────────────────
DEFECT_DOJO_API_TOKEN=
DEFECT_DOJO_ENGAGEMENT_ID=

# ── Hashicorp Vault ───────────────────────────────────────────────────────
VAULT_TOKEN=

# ── Grafana ───────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# ── OpenSearch ────────────────────────────────────────────────────────────
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=

# ── SonarQube ─────────────────────────────────────────────────────────────
SONAR_TOKEN=

# ── Sentry ────────────────────────────────────────────────────────────────
SENTRY_AUTH_TOKEN=

# ── GitLab ────────────────────────────────────────────────────────────────
GITLAB_TOKEN=

# ── DNS (Spaceship) ───────────────────────────────────────────────────────
SPACESHIP_API_KEY=
SPACESHIP_API_SECRET=

# ── Google OAuth (apply-google-observability) ────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
