POSTHOG:
- BOOTSTRAP=
- SHARED_INFRA=
- SECRET=
- ENCRYPTION_SALT_KEYS=

PROMETHEUS:
- RETENTION_TIME=

RABBITMQ:
- USER=
- PASSWORD=

RCLONE:
  AWS:
    - ACCESS_KEY_ID=
    - SECRET_ACCESS_KEY=
    - CONSOLE_URL=
    - CONSOLE_USER=
    - CONSOLE_PASSWORD=
  S3:
    - BUCKET=
    - OBJECT=
    - REGION=
  CRYPT:
    - PASSWORD=

# Private Sigstore stack (gitsign / cosign) — used by cmd/apply-commit.ps1
SIGSTORE:
- FULCIO_URL=https://fulcio.nottinfra.co.uk
- REKOR_URL=https://rekor.nottinfra.co.uk
- CTLOG_URL=https://ctlog.nottinfra.co.uk
- TUF_MIRROR_URL=https://tuf.nottinfra.co.uk
- OIDC_ISSUER=https://keycloak.nottinfra.co.uk/realms/nottinfra
- OIDC_CLIENT_ID=gitsign
- OIDC_REDIRECT_URL=http://127.0.0.1:27274/auth/callback
