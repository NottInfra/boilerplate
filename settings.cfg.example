# Copy to settings.cfg (gitignored; must be TUF-signed as settings.cfg.sig).
# Non-secret config only — secrets live in .env* / Vault.
# NETWORK=cluster|public selects ONPREM.ENDPOINTS.<SERVICE>.<CLUSTER|PUBLIC> → env as <SERVICE>_URL.
# CLOUDFLARE is managed-only. API token lives in .env.shared. Object storage is MinIO.

LOCAL:
  SIGSTORE:
    OIDC_REDIRECT_URL:
  GOOGLE:
    OAUTH_REDIRECT_URL:

ONPREM:
  ENDPOINTS:
    ALERTMANAGER:
