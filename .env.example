# Per-environment values. Shared secrets live in `.env.shared`.
# Service hosts live in settings.cfg → ENDPOINTS; NETWORK=cluster|public selects them.
# Push to Vault: ./cmd/apply-env.ps1

# ── Core ──────────────────────────────────────────────────────────────────────
ENV=
NETWORK= CLUSTER or PUBLIC

# ── Matomo (src) ──────────────────────────────────────────────────────────────
MATOMO_SITE_ID=

# ── GrowthBook (src) ──────────────────────────────────────────────────────────
GROWTHBOOK_CLIENT_KEY=

# ── OpenReplay (src) ──────────────────────────────────────────────────────────
OPENREPLAY_PROJECT_KEY=

# ── Sentry (src) ──────────────────────────────────────────────────────────────
SENTRY_PROJECT_ID=

# ── Database (cmd + src) — host from ENDPOINTS.DB via NETWORK ─────────────────
# --- DB names will be project name - env and rest will be hardcoded if cross db required ( user will have scoped access to required )
DB_USER=
DB_PASSWORD=
